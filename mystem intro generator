<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MY STEM UNIMAP — Intro Generator</title>
<style>
  :root{
    --cyan:#6ce4f0; --gold:#e0982e; --bg-deep:#050f14; --bg-panel:#0b1e26;
    --border:rgba(108,228,240,.18); --text:#eafbff; --muted:rgba(222,246,250,.62);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;min-height:100%;background:var(--bg-deep);
    font-family:"Segoe UI","Helvetica Neue",Helvetica,Arial,sans-serif;color:var(--text);}
  .wrap{max-width:1180px;margin:0 auto;padding:5vmin 4vmin 6vmin;}
  header{display:flex;align-items:center;gap:16px;margin-bottom:2.4rem;}
  header img{width:64px;height:auto;filter:drop-shadow(0 0 12px rgba(108,228,240,.4));}
  header h1{font-size:1.5rem;margin:0 0 .2rem;font-weight:800;letter-spacing:.01em;}
  header p{margin:0;color:var(--muted);font-size:.92rem;}

  .grid{display:flex;gap:2.4rem;flex-wrap:wrap;align-items:flex-start;}
  .panel{background:var(--bg-panel);border:1px solid var(--border);border-radius:14px;padding:1.8rem;flex:1 1 360px;}
  .panel h2{font-size:.78rem;letter-spacing:.28em;text-transform:uppercase;color:var(--gold);margin:0 0 1.3rem;}

  label{display:block;font-size:.82rem;color:var(--muted);margin:0 0 .35rem;letter-spacing:.02em;}
  input{width:100%;padding:.7rem .8rem;margin-bottom:1.15rem;background:#04121a;
    border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:.95rem;
    font-family:inherit;}
  input:focus{outline:none;border-color:var(--cyan);box-shadow:0 0 0 3px rgba(108,228,240,.15);}
  input::placeholder{color:rgba(222,246,250,.32);}

  .btn{width:100%;padding:.85rem 1rem;background:linear-gradient(135deg,var(--cyan),#3fb8cc);
    border:none;border-radius:8px;color:#02222b;font-weight:700;font-size:.95rem;
    letter-spacing:.03em;cursor:pointer;transition:filter .2s ease;}
  .btn:hover{filter:brightness(1.08);}
  .btn:active{filter:brightness(.95);}
  .hint-text{margin-top:.9rem;font-size:.78rem;color:var(--muted);line-height:1.5;}

  .preview-panel{flex:1 1 460px;}
  .preview-frame{position:relative;width:100%;aspect-ratio:16/9;border-radius:14px;overflow:hidden;
    border:1px solid var(--border);background:#000;}
  .preview-frame iframe{width:100%;height:100%;border:0;display:block;}
  .preview-label{display:flex;justify-content:space-between;align-items:center;margin-bottom:.8rem;}
  .preview-label span{font-size:.78rem;letter-spacing:.28em;text-transform:uppercase;color:var(--gold);}
  .replay-mini{background:none;border:1px solid var(--border);color:var(--muted);
    border-radius:6px;padding:.3rem .7rem;font-size:.78rem;cursor:pointer;}
  .replay-mini:hover{color:var(--text);border-color:var(--cyan);}

  footer{margin-top:2.4rem;text-align:center;color:var(--muted);font-size:.78rem;}
  @media(max-width:720px){ header img{width:48px;} }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <img id="headerLogo" alt="MY STEM UNIMAP">
    <div>
      <h1>Event Intro Generator</h1>
      <p>Fill in your event details, preview it live, then download a ready-to-play intro.</p>
    </div>
  </header>

  <div class="grid">
    <div class="panel">
      <h2>Event Details</h2>
      <label for="fName">Event name</label>
      <input id="fName" type="text" placeholder="e.g. STEM Innovation Night 2026">

      <label for="fTagline">Tagline / theme</label>
      <input id="fTagline" type="text" placeholder="e.g. Where Ideas Take Shape">

      <label for="fDate">Date &amp; time</label>
      <input id="fDate" type="text" placeholder="e.g. 12 September 2026 · 8:00 PM">

      <label for="fVenue">Venue</label>
      <input id="fVenue" type="text" placeholder="e.g. Dewan Utama, UniMAP">

      <button class="btn" id="downloadBtn" type="button">Download Intro (.html)</button>
      <p class="hint-text">Runs entirely in your browser — nothing is uploaded anywhere. Open the downloaded file and press F11 to go full screen at your event.</p>
    </div>

    <div class="preview-panel">
      <div class="preview-label">
        <span>Live Preview</span>
        <button class="replay-mini" id="replayPreview" type="button">↻ Replay</button>
      </div>
      <div class="preview-frame">
        <iframe id="previewFrame" title="Intro preview"></iframe>
      </div>
    </div>
  </div>

  <footer>MY STEM UNIMAP · Intro Generator</footer>
</div>

<script>
const LOGO_SRC = "data:image/png;base64,";
const TEMPLATE_RAW = "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>MY STEM UNIMAP \u2014 Event Intro</title>\n<style>\n  :root{\n    --cyan:#6ce4f0;\n    --cyan-soft:rgba(108,228,240,.35);\n    --gold:#e0982e;\n    --gold-soft:rgba(224,152,46,.45);\n    --bg-deep:#020a0e;\n    --bg-mid:#0a2732;\n    --text-light:#eafbff;\n    --text-muted:rgba(222,246,250,.62);\n  }\n  *{box-sizing:border-box;}\n  html,body{\n    margin:0; padding:0; width:100%; height:100%;\n    background:#000;\n    font-family:\"Segoe UI\",\"Helvetica Neue\",Helvetica,Arial,sans-serif;\n    overflow:hidden;\n  }\n  .frame{\n    width:100vw; height:100vh;\n    display:flex; align-items:center; justify-content:center;\n    background:#000;\n  }\n  .stage{\n    position:relative;\n    width:min(100vw,177.78vh);\n    height:min(100vh,56.25vw);\n    overflow:hidden;\n    background:radial-gradient(ellipse 90% 70% at 50% 40%, var(--bg-mid) 0%, var(--bg-deep) 62%, #000 100%);\n  }\n  .vignette{\n    position:absolute; inset:0; pointer-events:none; z-index:5;\n    background:radial-gradient(ellipse at 50% 50%, transparent 50%, rgba(0,0,0,.6) 100%);\n  }\n\n  /* ambient atom-orbit system */\n  .ambient{ position:absolute; inset:0; z-index:1; }\n  .glow{ position:absolute; border-radius:50%; filter:blur(4vmin); }\n  .glow-core{\n    width:56vmin; height:34vmin; top:50%; left:50%;\n    transform:translate(-50%,-52%);\n    background:radial-gradient(ellipse, var(--cyan-soft), transparent 70%);\n    animation:pulse 7s ease-in-out infinite;\n  }\n  .glow-gold{\n    width:22vmin; height:22vmin; top:50%; left:50%;\n    transform:translate(-50%,-52%);\n    background:radial-gradient(circle, var(--gold-soft), transparent 70%);\n    opacity:.5;\n    animation:pulse 7s ease-in-out infinite 2.3s;\n  }\n  @keyframes pulse{\n    0%,100%{ opacity:.55; transform:translate(-50%,-52%) scale(1); }\n    50%{ opacity:.85; transform:translate(-50%,-52%) scale(1.08); }\n  }\n\n  .orbit{\n    position:absolute; top:50%; left:50%;\n    width:70vmin; height:30vmin; margin:-15vmin 0 0 -35vmin;\n    border:1px solid rgba(108,228,240,.18);\n    border-radius:50%;\n  }\n  .orbit-a{ transform:rotate(-20deg); }\n  .orbit-b{ transform:rotate(38deg); border-color:rgba(108,228,240,.13); }\n  .orbit-c{ transform:rotate(85deg); border-color:rgba(108,228,240,.09); }\n\n  .orbit .spin{\n    position:absolute; inset:0; border-radius:50%;\n    animation:spin linear infinite;\n  }\n  .orbit-a .spin{ animation-duration:16s; }\n  .orbit-b .spin{ animation-duration:22s; animation-direction:reverse; }\n  .orbit-c .spin{ animation-duration:28s; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n\n  .e-dot{\n    position:absolute; top:-4px; left:50%; width:8px; height:8px; margin-left:-4px;\n    border-radius:50%;\n    background:radial-gradient(circle at 35% 30%, #fff, var(--cyan) 50%, #0c4552 100%);\n    box-shadow:0 0 5px 1px var(--gold), 0 0 12px 3px rgba(108,228,240,.7);\n  }\n\n  .sparkle{\n    position:absolute; width:4px; height:4px; background:#fff; opacity:0;\n    transform:rotate(45deg);\n    animation:twinkle 5s ease-in-out infinite;\n  }\n  @keyframes twinkle{\n    0%,100%{ opacity:0; transform:rotate(45deg) scale(.4); }\n    50%{ opacity:.9; transform:rotate(45deg) scale(1.3); }\n  }\n\n  /* content */\n  .content{\n    position:absolute; inset:0; z-index:3;\n    display:flex; flex-direction:column; align-items:center; justify-content:center;\n    text-align:center; padding:4vmin; gap:1.1vmin;\n  }\n  .logo-wrap{\n    opacity:0; transform:translateY(10px) scale(.85);\n    transition:opacity 1.5s ease, transform 1.5s cubic-bezier(.19,.87,.32,1);\n    margin-bottom:.4vmin;\n  }\n  .logo-wrap.show{ opacity:1; transform:translateY(0) scale(1); }\n  .logo-img{\n    display:block;\n    width:clamp(220px, 40vmin, 600px);\n    height:auto;\n    filter:drop-shadow(0 0 2.4vmin rgba(108,228,240,.55)) drop-shadow(0 0 .6vmin rgba(255,255,255,.5));\n    animation:float 6s ease-in-out infinite;\n  }\n  @keyframes float{ 0%,100%{ transform:translateY(0); } 50%{ transform:translateY(-1vmin); } }\n\n  .divider{\n    position:relative; width:0; height:1px;\n    background:linear-gradient(90deg, transparent, var(--gold), transparent);\n    transition:width 1.1s ease;\n  }\n  .divider.show{ width:13vmin; }\n  .divider::before{\n    content:''; position:absolute; top:50%; left:50%; width:6px; height:6px;\n    background:var(--gold); transform:translate(-50%,-50%) rotate(45deg);\n    box-shadow:0 0 6px var(--gold);\n  }\n\n  .presents{\n    font-size:clamp(11px, 1.5vmin, 19px); font-weight:600; letter-spacing:.5em;\n    text-transform:uppercase; color:var(--text-muted); margin-left:.3em;\n    opacity:0; transform:translateY(8px);\n    transition:opacity 1s ease, transform 1s ease;\n  }\n  .presents.show{ opacity:1; transform:translateY(0); }\n\n  .event-title{\n    font-size:clamp(26px, 6vmin, 84px); font-weight:800; letter-spacing:.01em;\n    color:var(--text-light); line-height:1.08; max-width:90%; margin:0;\n    text-shadow:0 0 4vmin rgba(108,228,240,.3);\n    opacity:0; transform:translateY(14px) scale(.97);\n    transition:opacity 1.1s ease, transform 1.1s cubic-bezier(.19,.87,.32,1);\n  }\n  .event-title.show{ opacity:1; transform:translateY(0) scale(1); }\n\n  .event-tagline{\n    font-size:clamp(13px, 2.1vmin, 25px); font-weight:400; color:var(--text-muted);\n    max-width:70%; margin:0;\n    opacity:0; transform:translateY(10px);\n    transition:opacity 1s ease, transform 1s ease;\n  }\n  .event-tagline.show{ opacity:1; transform:translateY(0); }\n\n  .event-meta{\n    margin-top:.4vmin; font-size:clamp(10px, 1.35vmin, 15px); font-weight:600;\n    letter-spacing:.32em; text-transform:uppercase; color:var(--gold);\n    opacity:0; transform:translateY(8px);\n    transition:opacity 1s ease, transform 1s ease;\n  }\n  .event-meta.show{ opacity:1; transform:translateY(0); }\n\n  .hint{\n    position:absolute; bottom:2.2vmin; left:50%; transform:translateX(-50%);\n    font-size:1.3vmin; letter-spacing:.12em; color:var(--text-muted);\n    opacity:0; transition:opacity 1.2s ease; z-index:4; white-space:nowrap;\n  }\n  .hint.show{ opacity:.65; }\n  .hint.hidden{ opacity:0; }\n\n  .replay{\n    position:absolute; bottom:1.7vmin; right:1.7vmin; z-index:4;\n    width:4vmin; height:4vmin; min-width:34px; min-height:34px;\n    border-radius:50%; border:1px solid rgba(222,246,250,.3);\n    background:rgba(255,255,255,.05); color:var(--text-muted);\n    font-size:1.7vmin; line-height:1; cursor:pointer;\n    opacity:0; transition:opacity .5s ease, background .2s ease, color .2s ease;\n  }\n  .replay.show{ opacity:.55; }\n  .replay:hover{ background:rgba(255,255,255,.14); color:#fff; opacity:.9; }\n  .replay:focus-visible{ outline:2px solid var(--cyan); outline-offset:2px; }\n\n  @media (prefers-reduced-motion: reduce){\n    .logo-img, .glow-core, .glow-gold, .sparkle, .orbit .spin{ animation:none !important; }\n    .logo-wrap, .divider, .presents, .event-title, .event-tagline, .event-meta, .hint{\n      transition-duration:.25s !important;\n    }\n  }\n</style>\n</head>\n<body>\n<div class=\"frame\">\n  <div class=\"stage\">\n    <div class=\"ambient\">\n      <div class=\"glow glow-core\"></div>\n      <div class=\"glow glow-gold\"></div>\n\n      <div class=\"orbit orbit-a\"><div class=\"spin\"><span class=\"e-dot\"></span></div></div>\n      <div class=\"orbit orbit-b\"><div class=\"spin\"><span class=\"e-dot\"></span></div></div>\n      <div class=\"orbit orbit-c\"><div class=\"spin\"><span class=\"e-dot\"></span></div></div>\n\n      <span class=\"sparkle\" style=\"top:18%; left:22%; animation-delay:.3s;\"></span>\n      <span class=\"sparkle\" style=\"top:72%; left:16%; animation-delay:1.4s;\"></span>\n      <span class=\"sparkle\" style=\"top:26%; left:80%; animation-delay:2.2s;\"></span>\n      <span class=\"sparkle\" style=\"top:66%; left:84%; animation-delay:.9s;\"></span>\n      <span class=\"sparkle\" style=\"top:85%; left:52%; animation-delay:1.8s;\"></span>\n    </div>\n\n    <div class=\"content\">\n      <div class=\"logo-wrap\" id=\"logoWrap\">\n        <img class=\"logo-img\" src=\"__LOGO_DATA_URI__\" alt=\"MY STEM UNIMAP\">\n      </div>\n      <div class=\"divider\" id=\"divider\"></div>\n      <div class=\"presents\" id=\"presents\">Presents</div>\n      <h1 class=\"event-title\" id=\"eventTitle\"></h1>\n      <p class=\"event-tagline\" id=\"eventTagline\"></p>\n      <p class=\"event-meta\" id=\"eventMeta\"></p>\n    </div>\n\n    <div class=\"vignette\"></div>\n    <div class=\"hint\" id=\"hint\">PRESS F11 FOR FULL SCREEN</div>\n    <button class=\"replay\" id=\"replayBtn\" type=\"button\" aria-label=\"Replay intro\">&#8635;</button>\n  </div>\n</div>\n\n<script>\n  /* ============================================================\n     EDIT THIS BLOCK FOR YOUR EVENT \u2014 nothing else needs to change.\n     ============================================================ */\n  const CONFIG = {\n    eventName:    \"__EVENT_NAME__\",\n    eventTagline: \"__EVENT_TAGLINE__\",\n    eventDate:    \"__EVENT_DATE__\",\n    eventVenue:   \"__EVENT_VENUE__\"\n  };\n  /* ============================================================ */\n\n  document.getElementById('eventTitle').textContent = CONFIG.eventName;\n  document.getElementById('eventTagline').textContent = CONFIG.eventTagline;\n  document.getElementById('eventMeta').textContent = CONFIG.eventDate + '   \\u00B7   ' + CONFIG.eventVenue;\n\n  const els = {\n    logo: document.getElementById('logoWrap'),\n    divider: document.getElementById('divider'),\n    presents: document.getElementById('presents'),\n    title: document.getElementById('eventTitle'),\n    tagline: document.getElementById('eventTagline'),\n    meta: document.getElementById('eventMeta'),\n    hint: document.getElementById('hint'),\n    replay: document.getElementById('replayBtn')\n  };\n\n  let timers = [];\n  function clearTimers(){ timers.forEach(clearTimeout); timers = []; }\n  function after(ms, fn){ timers.push(setTimeout(fn, ms)); }\n\n  function playSequence(){\n    clearTimers();\n    [els.logo, els.divider, els.presents, els.title, els.tagline, els.meta].forEach(function(el){\n      el.classList.remove('show');\n    });\n    els.hint.classList.remove('hidden');\n    els.hint.classList.add('show');\n    els.replay.classList.remove('show');\n\n    after(450,  function(){ els.logo.classList.add('show'); });\n    after(2200, function(){ els.divider.classList.add('show'); });\n    after(2500, function(){ els.presents.classList.add('show'); });\n    after(3300, function(){ els.title.classList.add('show'); });\n    after(4200, function(){ els.tagline.classList.add('show'); });\n    after(4900, function(){ els.meta.classList.add('show'); });\n    after(5600, function(){ els.hint.classList.add('hidden'); });\n    after(6200, function(){ els.replay.classList.add('show'); });\n  }\n\n  els.replay.addEventListener('click', playSequence);\n  window.addEventListener('load', playSequence);\n<\/script>\n</body>\n</html>\n";
const BASE_TEMPLATE = TEMPLATE_RAW.split('__LOGO_DATA_URI__').join(LOGO_SRC);

document.getElementById('headerLogo').src = LOGO_SRC;

function escJs(str){
  return String(str).replace(/\\/g,'\\\\').replace(/"/g,'\\"').replace(/\r?\n/g,' ');
}

function buildHtml(){
  const name    = document.getElementById('fName').value.trim()    || '[ EVENT NAME ]';
  const tagline = document.getElementById('fTagline').value.trim() || '[ Short tagline or theme ]';
  const date    = document.getElementById('fDate').value.trim()    || '[ DATE, TIME ]';
  const venue   = document.getElementById('fVenue').value.trim()   || '[ VENUE ]';

  let html = BASE_TEMPLATE;
  html = html.replace('__EVENT_NAME__', escJs(name));
  html = html.replace('__EVENT_TAGLINE__', escJs(tagline));
  html = html.replace('__EVENT_DATE__', escJs(date));
  html = html.replace('__EVENT_VENUE__', escJs(venue));
  return html;
}

let previewTimer = null;
function updatePreview(){
  clearTimeout(previewTimer);
  previewTimer = setTimeout(function(){
    document.getElementById('previewFrame').srcdoc = buildHtml();
  }, 450);
}

['fName','fTagline','fDate','fVenue'].forEach(function(id){
  document.getElementById(id).addEventListener('input', updatePreview);
});

document.getElementById('replayPreview').addEventListener('click', function(){
  document.getElementById('previewFrame').srcdoc = buildHtml();
});

document.getElementById('downloadBtn').addEventListener('click', function(){
  const html = buildHtml();
  const nameVal = document.getElementById('fName').value.trim();
  const slug = (nameVal ? nameVal.toLowerCase().replace(/[^a-z0-9]+/g,'_').replace(/^_+|_+$/g,'') : '') || 'event_intro';
  const blob = new Blob([html], {type:'text/html'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = slug + '_intro.html';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
});

updatePreview();
</script>
</body>
</html>